{
  "name": "boardgame-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@catalog/app",
    "build": "npm run build --workspace=@catalog/app",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@catalog/app",
    "test": "node --import tsx --test --test-isolation=none tests/contracts.test.ts tests/domain.test.ts",
    "test:db": "node --import tsx scripts/test-database.ts",
    "test:supabase": "node --import tsx scripts/test-supabase.ts",
    "test:editorial": "node --import tsx scripts/test-editorial.ts",
    "test:browser": "node --import tsx scripts/test-editorial.ts --browser",
    "setup:local": "node --import tsx scripts/setup-catalog-local.ts",
    "contracts:generate": "node --import tsx scripts/generate-contracts.ts",
    "contracts:check": "node --import tsx scripts/generate-contracts.ts --check",
    "check": "npm run typecheck && npm test && npm run contracts:check && npm run test:db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.116.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
